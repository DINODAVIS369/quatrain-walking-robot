      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.15" radius="0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_left_knee_joint" type="revolute">
    <parent link="rear_left_upper_leg"/>
    <child link="rear_left_lower_leg"/>
    <origin xyz="0.15 0.06 0" rpy="0 -1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1.0" velocity="1.0"/>
  </joint>

  <link name="rear_left_foot">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>

    <visual>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_left_ankle_joint" type="fixed">
    <parent link="rear_left_lower_leg"/>
    <child link="rear_left_foot"/>
    <origin xyz="0 0 -0.06" rpy="0 0 0"/>
  </joint>

  <!-- ================= REAR RIGHT LEG ================= -->

  <link name="rear_right_upper_leg">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" iyy="0.005" izz="0.005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.18 0.06 0.06"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.18 0.06 0.06"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_right_hip_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rear_right_upper_leg"/>
    <origin xyz="-0.2 -0.18 -0.075" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1.0" velocity="1.0"/>
  </joint>

  <link name="rear_right_lower_leg">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.002" izz="0.002" ixy="0" ixz="0" iyz="0"/>
